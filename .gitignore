php-8.5.10
php-docs
.tools/
dist/
# 主题构建产物需要随仓库分发 (开箱即用), 单独放行
!usr/themes/*/dist/

# 发布包压缩用的 Parcel 工具链依赖 (由 npm ci --prefix tools/assets 安装)
tools/assets/node_modules/
tools/assets/.parcel-cache/
.parcel-cache/
__pycache__/

# TypePHP 实验 (docs/guide/typephp.md) 在本地编译出的中间产物与二进制
tools/typephp/runner/build/
tools/typephp/runner/*.exe
tools/typephp/runner/*.lib
tools/typephp/runner/*.exp

# 数据库凭据 (含密钥路径等敏感配置, 安装时生成)
config.inc.php

# SQLite 数据库及 WAL/SHM/journal 辅助文件 (含用户哈希与全部内容, 安装时生成)
usr/*.db
usr/*.db-*
usr/*.sqlite
usr/*.sqlite-*
usr/*.sqlite3
usr/*.sqlite3-*

# 运行日志
*.log

# 系统与编辑器杂项
Thumbs.db
.DS_Store

# 本地临时目录 (PHPStan 缓存等; Windows 上跑 phpstan 需要把 TMPDIR/TEMP/TMP 指到可写目录)
.tmp/
.tmp-test/
