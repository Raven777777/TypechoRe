includes:
    - phpstan-baseline.neon

parameters:
    level: 0
    phpVersion: 80500
    # index.php only loads the generated, Git-ignored config.inc.php; it is still syntax-checked.
    paths:
        - admin
        - install
        - var
        - install.php
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
    excludePaths:
        analyse:
            - var/lbuchs/**
