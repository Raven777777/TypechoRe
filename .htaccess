# ============================================================
# TypechoRe 部署加固 (Apache)
#
# 本文件包含访问控制、安全响应头和永久链接重写规则。
# 未启用「地址重写」时, 带 index.php 的链接仍可正常使用。
# ============================================================

# 禁止目录列表
Options -Indexes

# ---- 保护敏感文件 ----
# 配置、SQLite 数据库和备份文件永远不应通过 URL 访问。
# 注意: 不要在这里屏蔽 install.php —— 它在检测到站点已安装后
# 会自动跳转到首页, 屏蔽反而会让全新站点无法安装。
<FilesMatch "(?i)^config\.inc\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(db|sqlite|sqlite3)(-(wal|shm|journal))?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(sql|bak|old|swp|log|dist|dat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 站点备份目录 (Widget\Backup 导出的数据含密码哈希和 authCode) 不对外提供
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^usr/backups(/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>

# ---- 屏蔽版本库 / 环境变量等元数据 ----
<IfModule mod_alias.c>
    RedirectMatch 404 "(?i)(^|/)(\.git|\.svn|\.hg)(/|$)"
    RedirectMatch 404 "(?i)(^|/)\.env(\.|$)"
    RedirectMatch 404 "(?i)(^|/)(composer\.(json|lock)|phpunit\.xml)$"
</IfModule>

# ---- 安全响应头 ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 关闭旧版 XSS Auditor (已被现代浏览器移除, 显式置 0 避免误报拦截)
    Header always set X-XSS-Protection "0"

    # 全站 HTTPS 且证书可信后再开启 HSTS, 否则会导致站点短期不可访问
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
