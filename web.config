<?xml version="1.0" encoding="UTF-8"?>
<!--
  TypechoRe 部署加固 (IIS 7+)

  注意: 不要屏蔽 install.php —— 它在检测到站点已安装后会自动跳转到首页,
  屏蔽会让全新站点无法安装。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 框架源码与安装片段不对外提供 -->
        <hiddenSegments>
          <add segment="var" />
          <add segment="install" />
          <add segment=".git" />
          <add segment=".svn" />
        </hiddenSegments>
        <!-- 数据库凭据文件 -->
        <denyUrlSequences>
          <add sequence="config.inc.php" />
        </denyUrlSequences>
        <!-- 备份/脚本文件 -->
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-XSS-Protection" value="0" />
        <!-- 全站 HTTPS 且证书可信后再启用 HSTS
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        -->
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
