<?xml version="1.0" encoding="UTF-8"?>
<!--
  TypechoRe 部署加固 (IIS 7+)

  注意: 不要屏蔽 install.php —— 它在检测到站点已安装后会自动跳转到首页,
  屏蔽会让全新站点无法安装。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 框架源码与安装片段不对外提供 -->
        <hiddenSegments>
          <add segment="var" />
          <add segment="install" />
          <add segment=".git" />
          <add segment=".svn" />
        </hiddenSegments>
        <!-- 数据库凭据文件 -->
        <denyUrlSequences>
          <add sequence="config.inc.php" />
          <!-- 后台备份 .dat 含用户密码摘要, 整个目录不对外 -->
          <add sequence="/usr/backups/" />
        </denyUrlSequences>
        <!-- 备份/脚本/数据库文件 -->
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sqlite3" allowed="false" />
          <add fileExtension=".db-wal" allowed="false" />
          <add fileExtension=".db-shm" allowed="false" />
          <add fileExtension=".db-journal" allowed="false" />
          <add fileExtension=".sqlite-wal" allowed="false" />
          <add fileExtension=".sqlite-shm" allowed="false" />
          <add fileExtension=".sqlite-journal" allowed="false" />
          <add fileExtension=".sqlite3-wal" allowed="false" />
          <add fileExtension=".sqlite3-shm" allowed="false" />
          <add fileExtension=".sqlite3-journal" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".dat" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-XSS-Protection" value="0" />
        <!-- 全站 HTTPS 且证书可信后再启用 HSTS
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        -->
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />
  </system.webServer>

  <!-- 上传目录只允许静态文件, 禁止脚本执行 -->
  <location path="usr/uploads">
    <system.webServer>
      <security>
        <requestFiltering>
          <fileExtensions>
            <add fileExtension=".php" allowed="false" />
            <add fileExtension=".php3" allowed="false" />
            <add fileExtension=".php4" allowed="false" />
            <add fileExtension=".php5" allowed="false" />
            <add fileExtension=".php7" allowed="false" />
            <add fileExtension=".php8" allowed="false" />
            <add fileExtension=".pht" allowed="false" />
            <add fileExtension=".phtml" allowed="false" />
            <add fileExtension=".phar" allowed="false" />
            <add fileExtension=".phps" allowed="false" />
            <add fileExtension=".html" allowed="false" />
            <add fileExtension=".htm" allowed="false" />
            <add fileExtension=".xhtml" allowed="false" />
            <add fileExtension=".shtml" allowed="false" />
            <add fileExtension=".svg" allowed="false" />
            <add fileExtension=".svgz" allowed="false" />
            <add fileExtension=".xml" allowed="false" />
            <add fileExtension=".xsl" allowed="false" />
            <add fileExtension=".xslt" allowed="false" />
            <add fileExtension=".cgi" allowed="false" />
            <add fileExtension=".pl" allowed="false" />
            <add fileExtension=".asp" allowed="false" />
            <add fileExtension=".aspx" allowed="false" />
            <add fileExtension=".jsp" allowed="false" />
          </fileExtensions>
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
